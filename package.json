{
  "name": "pulse-website",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "description": "The pulse website: home, docs generated from the pulse repositories, and the hosted plans page.",
  "type": "module",
  "packageManager": "bun@1.4.0",
  "engines": {
    "bun": "1.4.0"
  },
  "scripts": {
    "tokens": "bun scripts/tokens.ts",
    "build": "bun scripts/build.ts",
    "docs:bump": "bun scripts/bump-docs.ts",
    "check:links": "bun scripts/check-links.ts",
    "check:budget": "bun scripts/check-budget.ts",
    "check:a11y": "bun scripts/check-a11y.ts",
    "check:site": "bun run build && bun run check:links && bun run check:budget && bun run check:a11y",
    "typecheck": "bun node_modules/typescript7/bin/tsc --noEmit",
    "test": "bun test",
    "lint": "biome check . && pulse-eslint .",
    "format": "biome check --write .",
    "prepare": "lefthook install || true",
    "check": "bun run lint && bun run typecheck && bun run test",
    "check:all": "bun run check && bun run check:site"
  },
  "dependencies": {
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@fontsource-variable/space-grotesk": "5.3.0",
    "marked": "18.1.2",
    "preact": "11.1.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@biomejs/biome": "2.6.3",
    "@lorenzh/pulse-config": "github:lorenzh/pulse-config#86896e9ff02e6458e431aa3417ee81d3b1cbc335",
    "@playwright/test": "1.64.1",
    "@types/bun": "1.4.0",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "esbuild": "0.28.2",
    "lefthook": "2.2.2",
    "typescript7": "npm:typescript@7.0.2"
  }
}
