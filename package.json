{
  "name": "pulse-website",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "description": "The pulse website: home, docs generated from the pulse repositories, and the hosted plans page.",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "tokens": "node scripts/tokens.ts",
    "build": "node scripts/build.ts",
    "docs:bump": "node scripts/bump-docs.ts",
    "check:links": "node scripts/check-links.ts",
    "check:budget": "node scripts/check-budget.ts",
    "check:a11y": "node scripts/check-a11y.ts",
    "check:site": "npm run build && npm run check:links && npm run check:budget && npm run check:a11y",
    "typecheck": "tsc --noEmit",
    "test": "node --test --experimental-test-coverage --test-coverage-lines=80 --test-coverage-exclude='**/*.test.ts' --test-coverage-exclude='**/test/**' --test-coverage-exclude='.build/**' --test-coverage-exclude='dist/**' 'src/**/*.test.ts' 'scripts/**/*.test.ts'",
    "lint": "biome check . && pulse-eslint .",
    "format": "biome check --write .",
    "prepare": "lefthook install || true",
    "check": "npm run lint && npm run typecheck && npm run test",
    "check:all": "npm run check && npm run check:site"
  },
  "dependencies": {
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@fontsource-variable/space-grotesk": "5.3.0",
    "marked": "18.1.2",
    "preact": "11.1.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@biomejs/biome": "2.6.3",
    "@lorenzh/pulse-config": "github:lorenzh/pulse-config#8bdf9171917f115195095df93b8d90d23e90e9ac",
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "esbuild": "0.28.2",
    "lefthook": "2.2.2",
    "typescript": "7.0.2"
  }
}
